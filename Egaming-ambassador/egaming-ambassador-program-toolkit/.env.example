# ── CLUTCH Ambassador HQ — environment ───────────────────────────────
# Copy to .env.local for local dev, or set these in your host (Vercel).
# Everything here is OPTIONAL. With nothing set, the app runs in demo mode and
# ambassador applications are written to the server log.

# ── Where ambassador applications are delivered (pick ONE, easiest first) ──
# A Discord (or Slack / Guilded / Mattermost) incoming webhook URL.
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
# Each application drops into that channel. This is the recommended setup.
APPLY_WEBHOOK_URL=

# ...or deliver via a Telegram bot instead (used only if APPLY_WEBHOOK_URL is empty).
# Create a bot with @BotFather, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Links back to the live Clutch platform ──
# The deployed platform URL (Sign in / Get Tokens / Post deep-link here).
NEXT_PUBLIC_APP_URL=https://clutch.best
# Base URL of the live challenge API the board proxies (defaults to APP_URL).
API_BASE=

# ── Optional: persistent storage for mission/reward activity ──
# Only needed if you want the activity/points API to persist to Postgres.
# Leave empty to run without a database.
DATABASE_URL=

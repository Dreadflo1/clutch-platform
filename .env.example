# ── Game API Keys (add to Vercel Environment Variables) ──

# Riot Games — https://developer.riotgames.com
# Free: 100 req/2min (dev key), 30k/10s (production)
RIOT_API_KEY=

# Steam / Dota 2 — https://steamcommunity.com/dev/apikey
# Free: ~100k req/day
STEAM_API_KEY=

# Supercell — https://developer.clashroyale.com + https://developer.brawlstars.com
# Free: 10k req/day. NOTE: IP whitelist required — use Vercel's static IP
CLASH_ROYALE_API_KEY=
BRAWL_STARS_API_KEY=

# ── Vercel KV (balances, escrow, challenge board — REQUIRED in prod) ──
# Created automatically when you add KV from Vercel dashboard
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Server secrets (REQUIRED in prod — money & auth) ──
JWT_SECRET=                 # signs auth tokens
CHALLENGE_SECRET=           # HMAC-signs challenges
CRON_SECRET=                # gates the maintenance sweep (Vercel Cron sends it)
ADMIN_SECRET=               # gates admin dispute resolution + payouts-admin + reconcile
TELEGRAM_BOT_TOKEN=         # verifies Telegram login widget (if used)

# ── Economy ──
CLU_USD_RATE=0.10           # USD value of 1 CLU (1 USD = 10 CLU)

# ── Crypto deposits — rail 1: NOWPayments (managed, no hot wallet) ──
NOWPAYMENTS_API_KEY=        # from the NOWPayments dashboard
NOWPAYMENTS_IPN_SECRET=     # IPN secret — verifies the deposit webhook signature
NOWPAYMENTS_SUCCESS_URL=    # optional override
NOWPAYMENTS_CANCEL_URL=     # optional override

# ── Fiat deposits — rail 2: Stripe ──
STRIPE_SECRET_KEY=          # sk_live_… / sk_test_…
STRIPE_WEBHOOK_SECRET=      # whsec_… (from the webhook endpoint config)
STRIPE_SUCCESS_URL=         # optional override
STRIPE_CANCEL_URL=          # optional override

# ── Withdrawals (off-ramp) ──
# V1 payouts are ops-fulfilled via /api/wallet/payouts-admin (gated by
# ADMIN_SECRET) — no hot-wallet key or provider password stored on the server.

# ── OAuth account verification (optional — powers the "Verify" badge) ──
# Register each provider app with this exact redirect/callback URI:
#   https://clutch.best/api/oauth/callback   (also add the www. variant)
# Steam needs NO secret (OpenID 2.0) — enabled by STEAM_API_KEY above.
# Riot "Verify" reuses RIOT_API_KEY above (validates the Riot ID exists).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=            # YouTube
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
BATTLE_NET_CLIENT_ID=
BATTLE_NET_CLIENT_SECRET=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=       # optional override; default <origin>/api/oauth/callback

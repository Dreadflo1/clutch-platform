# ── Game API Keys (add to Vercel Environment Variables) ──

# Riot Games — https://developer.riotgames.com
# Free: 100 req/2min (dev key), 30k/10s (production)
RIOT_API_KEY=

# Steam / Dota 2 — https://steamcommunity.com/dev/apikey
# Free: ~100k req/day
STEAM_API_KEY=

# Supercell — https://developer.clashroyale.com + https://developer.brawlstars.com
# Free: 10k req/day. NOTE: IP whitelist required — use Vercel's static IP
CLASH_ROYALE_API_KEY=
BRAWL_STARS_API_KEY=

# ── Vercel KV (balances, escrow, challenge board — REQUIRED in prod) ──
# Created automatically when you add KV from Vercel dashboard
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Server secrets (REQUIRED in prod — money & auth) ──
JWT_SECRET=                 # signs auth tokens
CHALLENGE_SECRET=           # HMAC-signs challenges
CRON_SECRET=                # gates the maintenance sweep (Vercel Cron sends it)
ADMIN_SECRET=               # gates admin dispute resolution
TELEGRAM_BOT_TOKEN=         # verifies Telegram login widget (if used)

# ── Economy ──
CLU_USD_RATE=0.10           # USD value of 1 CLU (1 USD = 10 CLU)

# ── On-chain deposits (rail 1) ──
EVM_RPC_URL=                # RPC endpoint (Alchemy/Infura/…)
EVM_CHAIN_ID=               # optional: enforce a chain id
DEPOSIT_ADDRESS=            # platform receiving wallet
DEPOSIT_TOKEN=              # 'native' or an ERC-20 contract address (e.g. USDC)
DEPOSIT_TOKEN_DECIMALS=6    # e.g. 6 for USDC, 18 for native
DEPOSIT_TOKEN_USD=1         # USD per 1 token (1 for a USD stablecoin)
MIN_CONFIRMATIONS=3

# ── Stripe deposits (rail 2) ──
STRIPE_SECRET_KEY=          # sk_live_… / sk_test_…
STRIPE_WEBHOOK_SECRET=      # whsec_… (from the webhook endpoint config)
STRIPE_SUCCESS_URL=         # optional override
STRIPE_CANCEL_URL=          # optional override

# ══════════════════════════════════════════════════════════════════════
#  CLUTCH — environment variables
#  Set these in Vercel → Project → Settings → Environment Variables.
#  Grouped by what they unlock. TIER 1 is all you need for friends to play.
# ══════════════════════════════════════════════════════════════════════


# ─── TIER 1 · REQUIRED to play (sign in + duel with the free 500 CLU) ───

# The database (Upstash Redis / Vercel KV). WITHOUT THIS, no real duels.
# WHERE: Vercel → Storage → Create Database → "KV" (Upstash). It auto-injects
# these. Or create at https://upstash.com and copy the REST URL + token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (Upstash Marketplace naming also works if that's what your store injects:)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Signs login sessions (JWT). Must be a fixed random string, or logins break.
# WHERE: generate one →  openssl rand -hex 32
JWT_SECRET=

# Signs each challenge (anti-tamper HMAC). Also a fixed random string.
# WHERE: generate one →  openssl rand -hex 32
CHALLENGE_SECRET=


# ─── TIER 2 · Trustless auto-verify (optional; else honor-system) ───
# Without these, LoL/Valorant/Dota fall back to both-players-agree reporting.

# Valorant + League of Legends. WHERE: https://developer.riotgames.com
RIOT_API_KEY=
# Dota 2. WHERE: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# The OTHER games (CS2, Apex, Fortnite, ...) need no keys: both players enter
# the final score, matching numbers pay the winner, a mismatch disputes. Repeat
# disputers are auto-banned (see DISPUTE_BAN_THRESHOLD, default 2).


# ─── TIER 3 · Real money in/out (optional; free CLU needs none of this) ───

# Crypto deposits/payouts. WHERE: https://nowpayments.io dashboard → API.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SUCCESS_URL=https://YOUR-DOMAIN/wallet?deposit=success
NOWPAYMENTS_CANCEL_URL=https://YOUR-DOMAIN/wallet?deposit=cancel

# Card deposits. WHERE: https://dashboard.stripe.com (API keys + webhook signing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://YOUR-DOMAIN/wallet?deposit=success
STRIPE_CANCEL_URL=https://YOUR-DOMAIN/wallet?deposit=cancel

# CLU → USD display rate (default 0.10 if unset). WHERE: you decide.
CLU_USD_RATE=0.10


# ─── TIER 4 · Extra sign-in / account-linking (optional) ───
# MetaMask + Telegram already work; these add more login options.

# Telegram login. WHERE: message @BotFather → /newbot → token + username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Google. WHERE: https://console.cloud.google.com → Credentials → OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The OAuth callback (your deployed URL). WHERE: your domain.
OAUTH_REDIRECT_URI=https://YOUR-DOMAIN/api/oauth/callback
# Game-account linking (all optional) — each from its own developer portal:
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
BATTLE_NET_CLIENT_ID=
BATTLE_NET_CLIENT_SECRET=
PSN_CLIENT_ID=
PSN_CLIENT_SECRET=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=


# ─── TIER 5 · Admin / ops ───

# Protects admin endpoints (dispute resolution, payouts). Random string.
# WHERE: generate one →  openssl rand -hex 32
ADMIN_SECRET=
# Protects the scheduled maintenance cron. WHERE: generate one (Vercel Cron).
CRON_SECRET=


# NOTE: VERCEL_ENV and NODE_ENV are set automatically by Vercel — don't add them.
